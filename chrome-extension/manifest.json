{
  "manifest_version": 3,
  "name": "HowdyHire – Practice This Job",
  "version": "1.0.0",
  "description": "Send a job posting to HowdyHire and start a mock behavioral interview tailored to it.",
  "action": {
    "default_title": "Practice this job with HowdyHire"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.indeed.com/*",
        "https://*.joinhandshake.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.symplicity.com/*",
        "https://*.hireaggies.com/*",
        "https://hireaggies.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
